{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "types": [
            "vite/client",
            "jest"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "verbatimModuleSyntax": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
    ]
}